# Gradle
.gradle/
build/

# IDE
.idea/
*.iml

# Local configuration
local.properties

# Keystores and signing credentials — never commit these
*.jks
*.keystore
keystore.properties

# OS
.DS_Store
Thumbs.db

# Archives
*.zip

# Captured images — test shots never belong in version control.
# Scoped to what the app itself produces, so store screenshots added to store/
# later are not silently ignored.
captures/
SC_*.jpg
SC_*.dng

# Kotlin compiler error dumps
.kotlin/
